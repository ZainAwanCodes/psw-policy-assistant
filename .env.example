# PSW Policy Assistant - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (e.g., gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Local Embedding Model (SentenceTransformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Retrieval Configuration
TOP_K=4
MIN_SIMILARITY_SCORE=0.0

# Chunking Configuration
CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# LLM Generation Parameters
GENERATION_TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=1024

# Conversation Memory Window (number of user/assistant turn pairs)
CONVERSATION_HISTORY_WINDOW=6
